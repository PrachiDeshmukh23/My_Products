{
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/images/:path*", "destination": "/public/images/:path*" },
    { "source": "/uploads/:path*", "destination": "/public/uploads/:path*" },
    { "source": "/products", "destination": "/products.html" },
    { "source": "/product", "destination": "/products.html" },
    { "source": "/products.html", "destination": "/products.html" },
    { "source": "/products/sugarcane-special", "destination": "/products/sugarcane-special.html" },
    { "source": "/products/sugarcane-special.html", "destination": "/products/sugarcane-special.html" },
    { "source": "/products/onion-corn", "destination": "/products/onion-corn.html" },
    { "source": "/products/onion-corn.html", "destination": "/products/onion-corn.html" },
    { "source": "/products/soybean-cotton", "destination": "/products/soybean-cotton.html" },
    { "source": "/products/soybean-cotton.html", "destination": "/products/soybean-cotton.html" },
    { "source": "/products/crop-shakti", "destination": "/products/crop-shakti.html" },
    { "source": "/products/crop-shakti.html", "destination": "/products/crop-shakti.html" },
    { "source": "/products/detail", "destination": "/products/detail.html" },
    { "source": "/products/detail.html", "destination": "/products/detail.html" },
    { "source": "/admin", "destination": "/admin/dashboard.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/admin/dashboard", "destination": "/admin/dashboard.html" }
  ]
}
